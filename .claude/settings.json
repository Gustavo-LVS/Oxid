{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(gh release:*)",
      "Bash(gh workflow run:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(docker compose down:*)",
      "Bash(sqlx migrate revert:*)"
    ]
  }
}
